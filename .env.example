# =====================================================================
# ARC-VERIFY — Environment Configuration Template (SIH 2026 • PS 26261)
# AI-Powered Application Validation, Document Authentication &
# Regulatory Compliance Verification
# =====================================================================

# 1. Core Secrets (REQUIRED in all non-test environments)
# Minimum 32-character high-entropy secret for HMAC session signing
ARC_VERIFY_SESSION_SECRET=arc_verify_super_secure_session_secret_key_minimum_32_characters_2026

# HMAC key for tamper-evident audit ledger hashing (kept outside the DB)
ARC_VERIFY_AUDIT_KEY=arc_verify_audit_hmac_ledger_secret_key_si2026_ps26261

# Cookie security (true for production HTTPS, false for local HTTP dev)
COOKIE_SECURE=false

# 2. Local Document AI & Forensic Microservice (FastAPI)
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=8000

# 3. Upload & Resource Limits
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_PDF_PAGE_COUNT=50
ALLOWED_UPLOAD_MIMES=application/pdf,image/jpeg,image/png

# 4. Storage & Persistence
ARC_VERIFY_STORAGE_DIR=.arc-verify-data
ARC_VERIFY_DB_PATH=.arc-verify-data/arc_verify.db

# 5. External Registry / Issuer Adapters (Optional fallback to SOURCE_UNAVAILABLE)
AICTE_REGISTRY_API_URL=
DIGILOCKER_ISSUER_VERIFY_URL=
BANK_FDR_VERIFICATION_URL=

# 6. Demo Environment Controls (Defaults to true if unset for zero-config evaluation)
NEXT_PUBLIC_DEMO_MODE=true
ARC_VERIFY_DEMO_MODE=true

# 7. Gemini API Integration (Document Extraction, Chat Co-Pilot, Reviewer Explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

